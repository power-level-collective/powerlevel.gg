{
  "name": "powerlevel.gg",
  "version": "0.1.0",
  "description": "Website for Power Level Collective",
  "type": "module",
  "repository": "github/powerlevel.gg",
  "author": "Jean-Philippe Steinmetz <caskater47@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn css:build && rapidrest build",
    "css:build": "tailwindcss -i ./apps/www/_styles/globals.css -o ./public/styles/globals.css --minify",
    "css:watch": "tailwindcss -i ./apps/www/_styles/globals.css -o ./public/styles/globals.css --watch",
    "debug": "rapidrest dev --inspect",
    "dev": "rapidrest dev",
    "predev": "yarn css:build",
    "prebuild": "yarn css:build",
    "lint": "eslint ./apps ./src ./test",
    "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
    "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
    "dependency-check": "yarn dlx depcheck \"$@\"",
    "profile:process": "node --prof-process --call-graph",
    "profile:view": "npx speedscope",
    "start": "rapidrest start",
    "test": "rapidrest test --coverage",
    "test:watch": "rapidrest test --watch --coverage",
    "release": "rapidrest release",
    "export": "rapidrest react export",
    "preexport": "yarn css:build"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@rapidrest/core": "^5.1.0",
    "@rapidrest/react": "^1.0.2",
    "@rapidrest/service-core": "^1.4.0",
    "@types/node": "^26.4.0",
    "axios": "^1.20.0",
    "lodash-es": "^4.18.1",
    "nconf": "^0.13.0",
    "openapi3-ts": "^4.6.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@rapidrest/cli": "^1.0.1",
    "@swc/core": "^1.16.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/nconf": "^0.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "cross-spawn": "^7.0.6"
  },
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
